{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "incremental": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "noEmit": true,
    "isolatedModules": true,
    "module": "ESNext",
    "target": "ES2020"
  }
}
