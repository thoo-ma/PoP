# pnpm config (repo-wide)
# Isolated linker with public hoisting gives a flat node_modules (required for
# React Native / Metro) while keeping per-workspace React version isolation.
# React packages are excluded from public hoisting so frontend (React 19) and
# dashboard (React 18) each resolve the correct version from their own scope.
auto-install-peers=true
strict-peer-dependencies=false
public-hoist-pattern[]=*
public-hoist-pattern[]=!react
public-hoist-pattern[]=!react-dom
public-hoist-pattern[]=!@types/react
public-hoist-pattern[]=!@types/react-dom
