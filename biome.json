{
  "$schema": "https://biomejs.dev/schemas/2.4.9/schema.json",
  "files": {
    "includes": [
      "frontend/**",
      "!frontend/uniwind-types.d.ts",
      "shared/**",
      "dashboard/src/**",
      "!supabase/functions",
      "!google-cloud-run",
      "!**/node_modules",
      "!**/.next",
      "!**/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "formatWithErrors": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noUnknownAtRules": {
          "level": "error",
          "options": {
            "ignore": ["tailwind"]
          }
        }
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["heroui-native", "heroui-native/**"],
                "message": "Import HeroUI components from @/components/ui instead. Wrappers ensure consistent brand styling and tactile behavior."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["frontend/components/ui/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "heroui-native": {
                    "importNames": ["cn"],
                    "message": "Import cn from @/lib/tv so wrapper className merging uses the app's extended tailwind-merge config."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["frontend/App.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["frontend/components/dev/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  }
}
