{
  "$schema": "https://biomejs.dev/schemas/2.4.9/schema.json",
  "files": {
    "includes": [
      "frontend/**",
      "!frontend/uniwind-types.d.ts",
      "shared/**",
      "dashboard/src/**",
      "!supabase/functions",
      "!google-cloud-run",
      "!**/node_modules",
      "!**/.next",
      "!**/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "formatWithErrors": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noUnknownAtRules": {
          "level": "error",
          "options": {
            "ignore": ["tailwind"]
          }
        }
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": ["frontend/components/**", "frontend/hooks/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/components": "Import from the direct subpath (e.g. '@/components/shared/ProgressBar') to avoid require cycles.",
                  "@/hooks": "Import from the direct subpath (e.g. '@/hooks/useErrorHandler') to avoid require cycles."
                }
              }
            }
          }
        }
      }
    }
  ]
}
