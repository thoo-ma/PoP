{
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:frontend": "pnpm --filter pop run start",
    "dev:dashboard": "pnpm --filter dashboard run dev",
    "typecheck": "turbo typecheck",
