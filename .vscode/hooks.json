{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/worktree-setup.sh",
        "timeout": 120
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/worktree-cleanup.sh",
        "timeout": 30
      }
    ]
  }
}
