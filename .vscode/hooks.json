{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-setup.sh",
        "timeout": 120
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-cleanup.sh",
        "timeout": 30
      }
    ]
  }
}
