{
  "cli": {
    "version": ">= 13.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development",
        "EAS_USE_CACHE": "1"
      },
      "ios": {
        "image": "latest",
        "env": {
          "EXPO_USE_PRECOMPILED_MODULES": "0"
        }
      }
    },
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "preview",
        "EAS_USE_CACHE": "1"
      },
      "ios": {
        "image": "latest",
        "env": {
          "EXPO_USE_PRECOMPILED_MODULES": "0"
        }
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "env": {
        "EAS_USE_CACHE": "1"
      },
      "ios": {
        "image": "latest",
        "env": {
          "EXPO_USE_PRECOMPILED_MODULES": "0"
        }
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6761936677"
      },
      "android": {
        "track": "internal"
      }
    },
    "production": {
      "ios": {},
      "android": {
        "track": "production"
      }
    }
  }
}
